{
  "name": "devprod-lab",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "astro dev",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "verify": "npm run lint && npm run format:check && npm run check && npm run build && npm test && npm run test:browser"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "axe-core": "4.14.1",
    "eslint": "9.39.5",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  }
}
