---
import '../styles/global.css';
import CampaignHero from '../components/CampaignHero.astro';
import sample from '../campaigns/campaign-kickoff.json';

const fields = [
  { name: 'eyebrow', label: 'Campaign label', max: 36 },
  { name: 'headline', label: 'Headline', max: 90 },
  { name: 'description', label: 'Description', max: 240 },
  { name: 'slug', label: 'Page slug', max: 50 },
  { name: 'ctaLabel', label: 'Button label', max: 32 },
  { name: 'ctaUrl', label: 'Button destination (HTTPS)', max: 512, type: 'url' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Campaign Studio</title>
  </head>
  <body class="min-h-screen bg-[#f5f5ef] text-[#182d25]">
    <header class="border-b border-[#d9ddd3] bg-white">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-5 py-4 sm:px-8">
        <a href="/studio/" class="font-bold tracking-tight text-xl">Campaign Studio</a>
        <div class="flex gap-1 rounded-lg bg-[#edf0e9] p-1" role="group" aria-label="Demo role">
          <button type="button" data-role="marketer" class="rounded-md px-4 py-2 text-sm font-semibold aria-pressed:bg-white aria-pressed:shadow-sm" aria-pressed="true">Marketer</button>
          <button type="button" data-role="reviewer" class="rounded-md px-4 py-2 text-sm font-semibold aria-pressed:bg-white aria-pressed:shadow-sm" aria-pressed="false">Reviewer</button>
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-7xl px-5 py-8 sm:px-8 lg:py-12">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Landing page builder</h1>
          <p class="mt-2 text-[#465f54]">Draft campaign copy, preview the page, and try the review workflow.</p>
        </div>
        <a href="/studio/generate/" class="rounded-md bg-[#1a4435] px-4 py-2.5 text-sm font-bold text-white hover:bg-[#285744]">Generate with Codex</a>
        <p id="campaign-status" role="status" class="rounded-full border border-[#b9c9bf] bg-[#e9f0e8] px-4 py-2 text-sm font-semibold">Draft</p>
      </div>
      <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.3fr)]">
        <section class="min-w-0 rounded-xl border border-[#d9ddd3] bg-white p-5 sm:p-6" aria-labelledby="workspace-title">
          <h2 id="workspace-title" class="text-xl font-bold">Campaign details</h2>
          <form id="campaign-form" class="mt-5 space-y-4">
            <fieldset id="editor-fields" class="space-y-4 disabled:opacity-70">
              {fields.map((field) => (
                <label class="block text-sm font-semibold">
                  {field.label}
                  {field.name === 'description' ? (
                    <textarea name={field.name} rows="3" maxlength={field.max} required class="mt-1.5 block w-full rounded-md border border-[#aebdb3] p-2.5 font-normal">{sample[field.name]}</textarea>
                  ) : (
                    <input name={field.name} value={sample[field.name]} maxlength={field.max} required type={'type' in field ? field.type : 'text'} class="mt-1.5 block w-full rounded-md border border-[#aebdb3] p-2.5 font-normal" />
                  )}
                </label>
              ))}
            </fieldset>
            <button class="rounded-md bg-[#1a4435] px-4 py-2.5 text-sm font-bold text-white hover:bg-[#285744]" id="submit-campaign" type="submit">Submit for review</button>
          </form>
          <form id="review-form" class="mt-5 space-y-4" hidden>
            <p id="review-instructions" class="text-sm leading-relaxed text-[#465f54]">Review the preview and check both widths before making a decision.</p>
            <fieldset id="review-fields" class="space-y-4">
              <label class="block text-sm font-semibold">Review note
                <textarea id="review-note" rows="3" maxlength="300" class="mt-1.5 block w-full rounded-md border border-[#aebdb3] p-2.5 font-normal"></textarea>
              </label>
              <div class="flex flex-wrap gap-2">
                <button type="submit" class="rounded-md bg-[#1a4435] px-4 py-2.5 text-sm font-bold text-white">Approve draft</button>
                <button type="button" id="request-changes" class="rounded-md border border-[#aebdb3] px-4 py-2.5 text-sm font-bold">Request changes</button>
              </div>
            </fieldset>
          </form>
          <p id="review-feedback" class="mt-4 rounded-md bg-[#eff3ed] p-3 text-sm wrap-break-word" hidden></p>
          <p id="studio-error" role="alert" class="mt-4 text-sm font-semibold text-red-800" hidden></p>
          <div id="handoff" class="mt-5 space-y-2 border-t border-[#d9ddd3] pt-4" hidden>
            <button id="download-campaign" type="button" class="rounded-md border border-[#aebdb3] px-4 py-2.5 text-sm font-bold">Download for GitHub PR</button>
            <p class="text-xs leading-relaxed text-[#465f54]">The download contains the page copy for the repository. This browser demo saves review decisions on this device.</p>
          </div>
          <button id="new-draft" type="button" class="mt-5 text-sm font-semibold underline underline-offset-3" hidden>Start a new draft from this copy</button>
        </section>
        <section class="min-w-0 rounded-xl border border-[#d9ddd3] bg-white p-4 sm:p-5" aria-labelledby="preview-title">
          <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <div>
              <h2 id="preview-title" class="font-bold">Page preview</h2>
              <p id="page-path" class="mt-1 text-xs text-[#465f54] wrap-break-word">/lp/{sample.slug}/</p>
            </div>
            <div class="flex gap-1 rounded-lg bg-[#edf0e9] p-1" role="group" aria-label="Preview width">
              <button data-size="desktop" type="button" aria-pressed="true" class="rounded-md px-3 py-2 text-sm font-semibold aria-pressed:bg-white">Desktop</button>
              <button data-size="mobile" type="button" aria-pressed="false" class="rounded-md px-3 py-2 text-sm font-semibold aria-pressed:bg-white">Mobile</button>
            </div>
          </div>
          <div class="rounded-lg bg-[#e8ece4] p-2">
            <div id="campaign-preview" class="mx-auto w-full overflow-hidden rounded-md data-[width=mobile]:max-w-[390px]" data-width="desktop">
              <CampaignHero campaign={sample} preview />
            </div>
          </div>
        </section>
      </div>
    </main>
    <script src="../lib/studio.ts"></script>
  </body>
</html>
